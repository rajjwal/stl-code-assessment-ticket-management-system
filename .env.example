# OpenRouter API key for AI-powered features (extraction, enrichment, NL queries)
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Database URL (default: SQLite in project root)
DATABASE_URL=sqlite+aiosqlite:///./cmdb.db

# AI model to use via OpenRouter
AI_MODEL=meta-llama/llama-4-maverick

# Low temperature for deterministic structured output
AI_TEMPERATURE=0.1
